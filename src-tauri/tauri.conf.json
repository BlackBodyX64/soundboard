{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TikTok Soundboard",
  "version": "2.3.0",
  "identifier": "com.tiktoksoundboard.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "🎵 TikTok Soundboard",
        "width": 1550,
        "height": 750,
        "minWidth": 1480,
        "minHeight": 680,
        "decorations": false,
        "transparent": true,
        "resizable": true,
        "center": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}

